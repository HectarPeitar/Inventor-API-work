<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <MyType>Windows</MyType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <OutputPath>.\bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <PropertyGroup>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Company>Autodesk, Inc.</Company>
    <Copyright>Copyright © 2009 Autodesk, Inc.</Copyright>
    <Product>Autodesk Inventor</Product>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="My Project\AnalyzeControl.manifest" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Analyze.Designer.vb">
      <SubType>Code</SubType>
      <DependentUpon>Analyze.vb</DependentUpon>
    </Compile>
    <Compile Update="Analyze.vb">
      <SubType>UserControl</SubType>
    </Compile>
    <EmbeddedResource Update="Analyze.resX">
      <DependentUpon>Analyze.vb</DependentUpon>
      <SubType>Designer</SubType>
    </EmbeddedResource>
  </ItemGroup>
  <PropertyGroup>
    <ApplicationManifest>My Project\AnalyzeControl.manifest</ApplicationManifest>
  </PropertyGroup>
</Project>