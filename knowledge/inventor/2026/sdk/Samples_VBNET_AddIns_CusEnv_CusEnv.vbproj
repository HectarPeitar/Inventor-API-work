<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <MyType>Windows</MyType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <OutputPath>.\bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <PropertyGroup>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Company>Autodesk, Inc.</Company>
    <Copyright>Copyright © 2008–2009 Autodesk, Inc.</Copyright>
    <Description>Analyze path sample</Description>
    <Product>Autodesk Inventor</Product>
    <Title>Analyze path sample</Title>
  </PropertyGroup>
  <ItemGroup>
	  <Reference Include="Autodesk.Inventor.Interop">
		  <SpecificVersion>False</SpecificVersion>
		  <EmbedInteropTypes>False</EmbedInteropTypes>
		  <HintPath Condition="Exists('$(programfiles)\Autodesk\Inventor OEM 2026\Bin')">$(programfiles)\Autodesk\Inventor OEM 2026\Bin\Autodesk.Inventor.Interop.dll</HintPath>
          <HintPath Condition="Exists('$(programfiles)\Autodesk\Inventor 2026\Bin')">$(programfiles)\Autodesk\Inventor 2026\Bin\Autodesk.Inventor.Interop.dll</HintPath>
          <HintPath Condition="Exists('..\..\..\Bin')">..\..\..\Bin\Autodesk.Inventor.Interop.dll</HintPath>
		  <HintPath Condition="Exists('..\..\..\InventorSDK\Source\DeveloperTools\References\primaryinterop\CurrentVersion')">..\..\..\InventorSDK\Source\DeveloperTools\References\primaryinterop\CurrentVersion\Autodesk.Inventor.Interop.dll</HintPath>
		  <HintPath Condition="Exists('..\..\..\..\References\PrimaryInterop\CurrentVersion')">..\..\..\..\References\PrimaryInterop\CurrentVersion\Autodesk.Inventor.Interop.dll</HintPath>
		  <EmbedInteropTypes>False</EmbedInteropTypes>
		  <Private>True</Private>
	  </Reference>
    <COMReference Include="stdole">
      <Guid>{00020430-0000-0000-C000-000000000046}</Guid>
      <VersionMajor>2</VersionMajor>
      <VersionMinor>0</VersionMinor>
      <Lcid>0</Lcid>
      <WrapperTool>primary</WrapperTool>
      <Isolated>False</Isolated>
    </COMReference>
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Class Modules\AddInRegistration.vb" />
    <Compile Update="Class Modules\ApplicationEvts.vb">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Class Modules\CustomBrowserPane.vb">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Class Modules\InventorStandardAddIn.vb" />
    <Compile Update="Forms\FaceInformation.Designer.vb">
      <SubType>Code</SubType>
      <DependentUpon>FaceInformation.vb</DependentUpon>
    </Compile>
    <Compile Update="Forms\FaceInformation.vb">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Class Modules\Interaction.vb">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="My Project\AssemblyInfo.vb" />
    <Compile Update="My Project\Resources.Designer.vb">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="Class Modules\UserInputEvts.vb">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Class Modules\UserInterfaceEvts.vb">
      <SubType>Code</SubType>
    </Compile>
    <EmbeddedResource Update="Forms\FaceInformation.resX">
      <DependentUpon>FaceInformation.vb</DependentUpon>
      <SubType>Designer</SubType>
    </EmbeddedResource>
    <EmbeddedResource Update="My Project\Resources.resx">
      <Generator>VbMyResourcesResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.vb</LastGenOutput>
      <CustomToolNamespace>My.Resources</CustomToolNamespace>
      <SubType>Designer</SubType>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Icons\MeasureBody.bmp" />
    <EmbeddedResource Include="Icons\MeasureFace.bmp" />
    <EmbeddedResource Include="Icons\MeasureEdge.bmp" />
  </ItemGroup>
  <PropertyGroup>
    <ApplicationManifest>My Project\CustomEnvironment.manifest</ApplicationManifest>
  </PropertyGroup>
</Project>