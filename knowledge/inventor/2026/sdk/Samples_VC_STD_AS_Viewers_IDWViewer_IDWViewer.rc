//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDR_MAINFRAME           ICON                    "res\\IDWViewer.ico"
IDR_ACTACATYPE          ICON                    "res\\IDWViewerDoc.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "Open...",                     ID_FILE_OPEN
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About Inventor Drawing File Sample Viewer...", ID_APP_ABOUT
    END
END

IDR_SRVR_INPLACE MENU 
BEGIN
    POPUP "&Edit"
    BEGIN
        MENUITEM SEPARATOR
        MENUITEM "Refresh",                     ID_EDIT_REFRESH
    END
    MENUITEM SEPARATOR
    MENUITEM SEPARATOR
    POPUP "&Help"
    BEGIN
        MENUITEM "&About Inventor Drawing File Sample Viewer...", ID_APP_ABOUT
    END
END

IDR_SRVR_EMBEDDED MENU 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Update\tCtrl+S",             ID_FILE_UPDATE
        MENUITEM "Save Copy &As...",            ID_FILE_SAVE_COPY_AS
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM SEPARATOR
        MENUITEM "Refresh",                     ID_EDIT_REFRESH
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About Inventor Drawing File Sample Viewer...", ID_APP_ABOUT
    END
END


