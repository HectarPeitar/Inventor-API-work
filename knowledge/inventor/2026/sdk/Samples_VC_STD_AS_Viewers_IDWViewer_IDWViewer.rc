/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOGEX 0, 0, 239, 117
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Autodesk Inventor Drawing File Sample Viewer"
FONT 8, "Tahoma", 0, 0, 0x1
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,11,17,20,20
    LTEXT           "Autodesk® Inventor® Drawing File (IDW) Sample Viewer",IDC_STATIC,40,10,142,20,SS_NOPREFIX
    LTEXT           "Copyright © 2000–2010 Autodesk, Inc.",IDC_STATIC,40,32,135,10
    DEFPUSHBUTTON   "OK",IDOK,182,7,50,14,WS_GROUP
    LTEXT           "DWF Viewer is the easiest way for people who don't have AutoCAD® software to view the DWF file format.",IDC_STATIC,7,68,225,42
    CTEXT           "This sample requires the DWF™ Viewer control to be installed.",IDC_STATIC,7,49,225,14,SS_CENTERIMAGE,WS_EX_STATICEDGE
END

IDD_SHEETS DIALOG  0, 0, 226, 30
STYLE DS_SETFONT | WS_CHILD
FONT 8, "Tahoma"
BEGIN
    COMBOBOX        IDC_SHEETLIST,44,7,175,275,CBS_DROPDOWN | WS_VSCROLL | WS_TABSTOP
    RTEXT           "Sheet: ",IDC_STATIC,3,7,39,13
END

IDD_DRAWING DIALOGEX 0, 0, 276, 191
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Dialog"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "",IDC_ADVIEWER2,"{A662DA7E-CCB7-4743-B71A-D817F6D575DF}",WS_TABSTOP,72,21,136,123
END


