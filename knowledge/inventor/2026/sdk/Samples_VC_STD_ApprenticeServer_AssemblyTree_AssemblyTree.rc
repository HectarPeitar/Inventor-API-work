/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDR_MAINFRAME           ICON                    "res\\AssemblyTree.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOGEX 0, 0, 235, 55
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | 
    WS_SYSMENU
CAPTION "About AssemblyTree"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,11,17,20,20
    LTEXT           "AssemblyTree Version 1.0",IDC_STATIC,40,10,119,8,
                    SS_NOPREFIX
    LTEXT           "Copyright (C) 2004",IDC_STATIC,40,25,119,8
    DEFPUSHBUTTON   "OK",IDOK,178,7,50,16,WS_GROUP
END

IDD_ASSEMBLYTREE_DIALOG DIALOGEX 0, 0, 307, 245
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | 
    WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "AssemblyTree"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    PUSHBUTTON      "Close",IDC_CLOSE_BUTTON,179,222,50,16
    CONTROL         "",IDC_ASSEMBLY_TREE,"SysTreeView32",TVS_HASBUTTONS | 
                    TVS_HASLINES | TVS_LINESATROOT | TVS_SHOWSELALWAYS | 
                    WS_BORDER | WS_TABSTOP,25,62,249,148
    PUSHBUTTON      "Browse...",IDC_BROWSE_BUTTON,224,20,45,17
    EDITTEXT        IDC_FILENAME_EDITBOX,32,20,188,17,ES_AUTOHSCROLL
    LTEXT           "Assembly Tree:",IDC_ASSEMBLYTREE_STATIC,25,51,81,8
    GROUPBOX        "File Name:",IDC_FILENAME_STATIC,26,7,249,37
    PUSHBUTTON      "Refresh Tree",IDC_REFRESHTREE_BUTTON,103,222,50,16
END


