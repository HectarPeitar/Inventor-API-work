REGEDIT
; This .REG file may be used by your SETUP program.
;   If a SETUP program is not available, the entries below will be
;   registered in your InitInstance automatically with a call to
;   CWinApp::RegisterShellFileTypes and COleObjectFactory::UpdateRegistryAll.

HKEY_CURRENT_USER\Software\Classes\.rbox = RefBoxApp.Document
HKEY_CURRENT_USER\Software\Classes\RefBoxApp.Document\shell\open\command = REFBOXAPP.EXE %1
HKEY_CURRENT_USER\Software\Classes\RefBoxApp.Document\shell\open\ddeexec = [open("%1")]
HKEY_CURRENT_USER\Software\Classes\RefBoxApp.Document\shell\open\ddeexec\application = REFBOXAPP
    ; note: the application is optional
    ;  (it defaults to the app name in "command")

HKEY_CURRENT_USER\Software\Classes\RefBoxApp.Document = RefBox Document
