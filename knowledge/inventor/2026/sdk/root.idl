		[id(0x03001203)] HRESULT ExecuteCommand([in] long CommandID);
		[propget, id(0x03001204)] HRESULT Automation([out, retval] IDispatch * * Result);
[!if !ADDIN_APPTYPE]
		[propget, id(0x03002f01)] HRESULT HasOpenOptions([in] IDispatch* SourceData, [in] IDispatch* Context, [in] IDispatch* DefaultOptions, [out, retval] VARIANT_BOOL* Result);
		[id(0x03002f02)] HRESULT ShowOpenOptions([in] IDispatch* SourceData, [in] IDispatch* Context, [in] IDispatch* ChosenOptions);
