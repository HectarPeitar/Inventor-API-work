		[propget, id(0x03002f04)] HRESULT HasSaveCopyAsOptions([in] IDispatch* SourceObject, [in] IDispatch* Context, [in] IDispatch* DefaultOptions, [out, retval] VARIANT_BOOL* Result);
		[id(0x03002f05)] HRESULT ShowSaveCopyAsOptions([in] IDispatch* SourceObject, [in] IDispatch* Context, [in] IDispatch* ChosenOptions);
		[id(0x03002f06)] HRESULT SaveCopyAs([in] IDispatch* SourceObject, [in] IDispatch* Context, [in] IDispatch* Options, [in] IDispatch* TargetData);
		[id(0x03002f07)] HRESULT GetThumbnail([in] IDispatch* SourceData, [out, retval] VARIANT* Result);
[!endif]
